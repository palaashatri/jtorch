# Keep the repository and every CI checkout byte-identical across platforms.
# Generated outputs are compared with Files.readString, so CRLF checkouts on
# Windows must not leak into the verifyGeneratedClean check.
* text=auto

*.java   text eol=lf
*.json   text eol=lf
*.md     text eol=lf
*.toml   text eol=lf
*.kts    text eol=lf
*.yml    text eol=lf
*.yaml   text eol=lf
*.py     text eol=lf
*.sh     text eol=lf
gradlew  text eol=lf

# Binary artifacts must never be normalized.
*.jar    binary
*.safetensors binary
*.png    binary
*.jpg    binary
*.jpeg   binary
*.gif    binary
*.ico    binary
*.icns   binary
*.zip    binary
